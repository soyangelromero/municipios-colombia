# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

# Token de aplicación de datos.gov.co (opcional; sube el límite de peticiones).
# Se obtiene gratis en https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Contacto que se envía en el User-Agent al consultar sitios web (cortesía con los servidores).
CONTACTO_RASTREO=
