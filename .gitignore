# Entornos y secretos
.venv/
venv/
.env
# privado/: secretos y la base SQLite, fuera de la carpeta pública. Solo el ejemplo se versiona.
privado/*
!privado/config.example.php
*.sqlite
*.sqlite3

# Datos descargados o intermedios (se regeneran con el pipeline)
datos/crudos/
datos/intermedios/

# Sitio generado por el pipeline (python -m municipios sitio): se publica, no se versiona
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/

# Configuración local de herramientas
.claude/

# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Partes del relevamiento (se juntan con `relevamiento --unir`)
datos/relevamiento/parciales/
